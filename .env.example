# ─────────────────────────────────────────────────────────────────
# STIX 2.1 Threat Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git.
# ─────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────
# JWT signing secret — MUST be set or the server will refuse to start.
# Generate a secure key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-change-this-in-production

# ── JWT Token Lifetimes ───────────────────────────────────────────
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ── ML Configuration ──────────────────────────────────────────────
# Minimum number of events before the Isolation Forest auto-trains.
# Use 5 for development/testing; 50+ for production.
ML_MIN_TRAIN_SAMPLES=50
ML_CONTAMINATION=0.05
ML_MODEL_DIR=models
ML_RETRAIN_INTERVAL=100

# ── CORS ──────────────────────────────────────────────────────────
# Frontend URL added to CORS allowed origins
FRONTEND_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────
# SQLite database location (created automatically on first run)
# DB_PATH=database/threat_intel.db

# ── Scheduler ─────────────────────────────────────────────────────
# How often (in minutes) the TAXII feeds are polled
SCHEDULER_INTERVAL_MINUTES=30

# ── TAXII Feed 1: AlienVault OTX (free with API key) ──────────────
# Register at https://otx.alienvault.com to get your API key
FEED_1_NAME=AlienVault OTX
FEED_1_URL=https://otx.alienvault.com/taxii/taxii2/
FEED_1_AUTH=api_key
FEED_1_API_KEY=your-otx-api-key-here
FEED_1_ENABLED=true

# ── TAXII Feed 2: CISA AIS (US Gov, free, no auth) ───────────────
FEED_2_NAME=CISA AIS
FEED_2_URL=https://ais2.cisa.dhs.gov/taxii2/
FEED_2_AUTH=none
FEED_2_ENABLED=false

# ── TAXII Feed 3: Anomali Limo (free guest account) ───────────────
FEED_3_NAME=Anomali Limo
FEED_3_URL=https://limo.anomali.com/api/v1/taxii2/feeds/
FEED_3_AUTH=basic
FEED_3_USERNAME=guest
FEED_3_PASSWORD=guest
FEED_3_ENABLED=false

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
